---
const features = [
  {
    title: "Tabs",
    text: "Open several sessions and switch between them from the sidebar.",
    keys: ["Ctrl+Shift+T"],
  },
  {
    title: "Panel splitting",
    text: "Split any panel horizontally or vertically.",
    keys: ["Alt+P", "Alt+="],
  },
  {
    title: "Resizable panes",
    text: "Drag the border between panels to resize them.",
    keys: [],
  },
  {
    title: "Focus navigation",
    text: "Jump between panels without touching the mouse.",
    keys: ["Alt+Arrows"],
  },
  {
    title: "Collapsible sidebar",
    text: "Shrink the sidebar down to icons when you want more room.",
    keys: ["Alt+B"],
  },
  {
    title: "Adjustable font size",
    text: "Change the font size at runtime.",
    keys: ["Ctrl++", "Ctrl+-"],
  },
  {
    title: "Panel swapping",
    text: "Hold Alt and drag a panel onto another to swap them.",
    keys: ["Alt+Drag"],
  },
  {
    title: "Projects",
    text: "Add git repositories to the sidebar as projects.",
    keys: ["Ctrl+Shift+O"],
  },
  {
    title: "Worktrees",
    text: "Every worktree is listed under its project, with live diff stats.",
    keys: [],
  },
  {
    title: "Pinned sessions",
    text: "Tabs are pinned to a worktree, so a branch's sessions stay grouped.",
    keys: [],
  },
  {
    title: "Session restore",
    text: "Sessions are saved and restored between runs.",
    keys: [],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/icon.png" />
    <title>marcterm - A fast GPU-accelerated terminal emulator for parallel coding and AI agents</title>
    <meta
      name="description"
      content="marcterm is a fast, GPU-accelerated terminal emulator built with Rust and Freya. Split panels, tabs, git worktrees and keyboard-driven workflows, ideal for coding and running AI agents."
    />
    <meta
      name="keywords"
      content="terminal, terminal emulator, marcterm, coding, developer tools, AI, AI agents, agentic coding, Claude Code, opencode, Codex, Rust, Freya, GPU accelerated, split panels, tabs, git worktrees, Linux terminal"
    />
    <meta name="author" content="Marc Espin" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0f0f0f" />
    <link rel="canonical" href="https://term.mespin.me/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="marcterm" />
    <meta property="og:title" content="marcterm - A fast terminal emulator for parallel coding and AI agents" />
    <meta
      property="og:description"
      content="A fast, GPU-accelerated terminal emulator built with Rust and Freya. Split panels, tabs, git worktrees and keyboard-driven workflows for parallel coding and AI agents."
    />
    <meta property="og:url" content="https://term.mespin.me/" />
    <meta property="og:image" content="https://term.mespin.me/screenshot.png" />
    <meta property="og:image:alt" content="marcterm terminal emulator with split panels and a project sidebar" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="marcterm - A fast terminal emulator for parallel coding and AI agents" />
    <meta
      name="twitter:description"
      content="A fast, GPU-accelerated terminal emulator built with Rust and Freya. Split panels, tabs, git worktrees and keyboard-driven workflows for parallel coding and AI agents."
    />
    <meta name="twitter:image" content="https://term.mespin.me/screenshot.png" />
    <meta name="twitter:creator" content="@marc2332" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "marcterm",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Linux",
        description:
          "A fast, GPU-accelerated terminal emulator built with Rust and Freya. Split panels, tabs, git worktrees and keyboard-driven workflows for parallel coding and AI agents.",
        url: "https://term.mespin.me/",
        image: "https://term.mespin.me/screenshot.png",
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
        },
        author: {
          "@type": "Person",
          name: "Marc Espin",
          url: "https://mespin.me",
          sameAs: ["https://github.com/marc2332"],
        },
        codeRepository: "https://github.com/marc2332/term",
      })}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="backdrop" aria-hidden="true"></div>

    <main>
      <header class="hero">
        <img class="logo" src="/icon.png" alt="marcterm logo" width="96" height="96" />
        <h1>marcterm</h1>
        <p class="tagline">
          A fast and powerful terminal emulator designed for parallel coding
          and AI agents, built with
          <a href="https://freyaui.dev">Freya</a> and Rust.
        </p>
        <div class="actions">
          <a class="button primary" href="#install">Install</a>
          <a class="button" href="https://github.com/marc2332/term">Source code</a>
        </div>
      </header>

      <section class="shot">
        <img
          src="/screenshot.png"
          alt="marcterm terminal emulator running with split panels and the project sidebar open"
        />
      </section>

      <section class="about">
        <p>
          <strong>marcterm</strong> is a fast, minimal terminal emulator for
          people who like to keep several coding sessions going at once. Group
          your work into projects, jump between sessions from the home view,
          and split any panel into as many panes as you need. Everything is
          keyboard driven, so your hands never have to leave the home row.
        </p>
        <p>
          It is also a great fit for agentic workflows. Run AI coding agents
          like Claude Code, opencode or Codex side by side in split panels, and
          keep each agent on its own git worktree with live diff stats in the
          sidebar. The worktrees integration is mostly designed around how
          <a href="https://github.com/marc2332/git">marcgit</a> works, so it
          may not fit other worktree layouts as well.
        </p>
        <p>
          It is written in Rust on top of
          <a href="https://freyaui.dev">Freya</a>, a native GUI
          framework. That means real GPU rendering, low input latency, and a
          small footprint. The full source code is available
          <a href="https://github.com/marc2332/term">on GitHub</a>.
        </p>
      </section>

      <section class="features">
        <h2>Features</h2>
        <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Feature</th>
              <th>Description</th>
              <th class="keys-col">Shortcut</th>
            </tr>
          </thead>
          <tbody>
            {
              features.map((f) => (
                <tr>
                  <th scope="row">{f.title}</th>
                  <td>{f.text}</td>
                  <td class="keys-col">
                    {f.keys.map((k) => <kbd>{k}</kbd>)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        </div>
      </section>

      <section class="install" id="install">
        <h2>Install</h2>
        <div class="install-block">
          <h3>Flatpak (Linux)</h3>
          <pre><code>flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak remote-add --if-not-exists --no-gpg-verify --user marcterm https://marc2332.github.io/term
flatpak install --user marcterm io.marc.term</code></pre>
        </div>
        <div class="install-block">
          <h3>Cargo</h3>
          <pre><code>cargo install --git https://github.com/marc2332/term</code></pre>
        </div>
      </section>

      <footer>
        <p>
          <strong>marcterm</strong> is made by
          <a href="https://mespin.me">Marc Espin</a> ·
          <a href="https://github.com/marc2332">GitHub</a> ·
          <a href="https://github.com/marc2332/term">Source code</a>
        </p>
      </footer>
    </main>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family:
          "Inter",
          system-ui,
          -apple-system,
          sans-serif;
        background: rgb(15, 15, 15);
        color: rgb(220, 220, 220);
        line-height: 1.6;
        min-height: 100vh;
      }

      /* Soft mesh backdrop of radial gradient blobs, same palette as the app */
      .backdrop {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background-image:
          radial-gradient(
            circle 280px at 80px 80px,
            rgba(30, 46, 64, 0.63) 0%,
            rgba(30, 46, 64, 0.43) 30%,
            rgba(30, 46, 64, 0.2) 62%,
            transparent 95%
          ),
          radial-gradient(
            circle 310px at 270px 410px,
            rgba(38, 66, 52, 0.63) 0%,
            rgba(38, 66, 52, 0.43) 30%,
            rgba(38, 66, 52, 0.2) 62%,
            transparent 95%
          ),
          radial-gradient(
            circle 330px at 110px 710px,
            rgba(62, 54, 30, 0.63) 0%,
            rgba(62, 54, 30, 0.43) 30%,
            rgba(62, 54, 30, 0.2) 62%,
            transparent 95%
          ),
          radial-gradient(
            circle 300px at 50% 40px,
            rgba(44, 38, 72, 0.63) 0%,
            rgba(44, 38, 72, 0.43) 30%,
            rgba(44, 38, 72, 0.2) 62%,
            transparent 95%
          ),
          radial-gradient(
            circle 320px at 50% calc(100% - 60px),
            rgba(28, 58, 62, 0.63) 0%,
            rgba(28, 58, 62, 0.43) 30%,
            rgba(28, 58, 62, 0.2) 62%,
            transparent 95%
          ),
          radial-gradient(
            circle 300px at calc(100% + 100px) 420px,
            rgba(58, 36, 60, 0.63) 0%,
            rgba(58, 36, 60, 0.43) 30%,
            rgba(58, 36, 60, 0.2) 62%,
            transparent 95%
          );
      }

      main {
        max-width: 880px;
        margin: 0 auto;
        padding: 0 24px;
      }

      a {
        color: rgb(150, 180, 220);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      h2 {
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 16px;
      }

      section {
        margin-bottom: 80px;
      }

      /* Hero */
      .hero {
        text-align: center;
        padding: 96px 0 56px;
      }

      .logo {
        border-radius: 20px;
        margin-bottom: 20px;
      }

      .hero h1 {
        font-size: 3rem;
        font-weight: 800;
        letter-spacing: -0.03em;
      }

      .tagline {
        font-size: 1.15rem;
        color: rgb(170, 170, 175);
        margin-top: 8px;
        max-width: 34em;
        margin-left: auto;
        margin-right: auto;
        text-wrap: balance;
      }

      .actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 28px;
      }

      .button {
        display: inline-block;
        padding: 10px 22px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.95rem;
        color: rgb(225, 225, 225);
        background: rgba(80, 78, 86, 0.35);
        border: 1px solid rgb(58, 56, 62);
        transition: background 0.15s ease;
      }

      .button:hover {
        background: rgba(80, 78, 86, 0.55);
        text-decoration: none;
      }

      .button.primary {
        background: rgb(225, 225, 225);
        color: rgb(15, 15, 15);
        border-color: transparent;
      }

      .button.primary:hover {
        background: rgb(200, 200, 200);
      }

      /* Screenshot */
      .shot img {
        width: 100%;
        border-radius: 12px;
        border: 1px solid rgb(58, 56, 62);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
      }

      /* About */
      .about p + p {
        margin-top: 12px;
      }

      .about p {
        color: rgb(190, 190, 195);
        max-width: 64ch;
      }

      /* Features */
      .table-wrap {
        background: rgba(32, 31, 35, 0.75);
        border: 1px solid rgb(58, 56, 62);
        border-radius: 12px;
        overflow: hidden;
        overflow-x: auto;
      }

      .features table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
      }

      .features th,
      .features td {
        padding: 12px 20px;
        text-align: left;
        vertical-align: top;
      }

      .features thead th {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgb(140, 140, 145);
        border-bottom: 1px solid rgb(58, 56, 62);
      }

      .features tbody tr + tr th,
      .features tbody tr + tr td {
        border-top: 1px solid rgb(45, 44, 48);
      }

      .features tbody th {
        font-weight: 600;
        white-space: nowrap;
      }

      .features tbody td {
        color: rgb(170, 170, 175);
      }

      .keys-col {
        text-align: right;
      }

      .keys-col kbd + kbd {
        margin-left: 6px;
      }

      kbd {
        font-family: ui-monospace, "Cascadia Code", "Fira Code", monospace;
        font-size: 0.75rem;
        color: rgb(200, 200, 205);
        background: rgb(24, 23, 26);
        border: 1px solid rgb(58, 56, 62);
        border-bottom-width: 2px;
        border-radius: 6px;
        padding: 3px 8px;
        white-space: nowrap;
      }

      /* Install */
      .install-block + .install-block {
        margin-top: 24px;
      }

      .install-block h3 {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 8px;
      }

      pre {
        background: rgba(32, 31, 35, 0.9);
        border: 1px solid rgb(58, 56, 62);
        border-radius: 10px;
        padding: 16px;
        overflow-x: auto;
      }

      code {
        font-family: ui-monospace, "Cascadia Code", "Fira Code", monospace;
        font-size: 0.85rem;
        color: rgb(200, 210, 200);
      }

      /* Footer */
      footer {
        border-top: 1px solid rgb(45, 44, 48);
        padding: 32px 0 48px;
        text-align: center;
        font-size: 0.9rem;
        color: rgb(140, 140, 145);
      }

      @media (max-width: 600px) {
        .hero {
          padding-top: 64px;
        }

        .hero h1 {
          font-size: 2.2rem;
        }
      }
    </style>
  </body>
</html>
