<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.marc.term</id>
  <name>marcterm</name>
  <summary>Terminal emulator built with Freya and Rust</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.marc2332">
    <name>Marc Espin</name>
  </developer>
  <description>
    <p>
      Terminal emulator built with Freya and Rust. Supports tabs, panel
      splitting (horizontal, vertical, and 2x2 grid), resizable panes,
      and adjustable font size.
    </p>
  </description>
  <launchable type="desktop-id">io.marc.term.desktop</launchable>
  <url type="homepage">https://github.com/marc2332/marcterm</url>
  <url type="bugtracker">https://github.com/marc2332/marcterm/issues</url>
  <url type="vcs-browser">https://github.com/marc2332/marcterm</url>
  <content_rating type="oars-1.1" />
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/marc2332/marcterm/main/demo.png</image>
      <caption>Marcterm with split panels</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="0.4.7" date="2026-08-24">
      <description><p>Update Freya to 0.5.0-rc.4 and switch to its borderless window plugin.</p></description>
    </release>
    <release version="0.4.6" date="2026-08-20">
      <description><p>Run each shell in its own systemd scope so one OOM kill cannot take every panel down.</p></description>
    </release>
    <release version="0.4.5" date="2026-08-20">
      <description><p>Keep PTYs alive on transient read errors.</p></description>
    </release>
    <release version="0.4.3" date="2026-08-17">
      <description><p>Exited shell overlays, opt-in directory CLI argument, animated modal popups.</p></description>
    </release>
    <release version="0.4.2" date="2026-08-05">
      <description><p>Collapsible worktree and tab groups in the sidebar, panel styling refresh, context menus on press.</p></description>
    </release>
    <release version="0.4.1" date="2026-07-28">
      <description><p>Confirmation dialogs, archived worktree filtering and ordering, context menu icons and hover actions in project headers.</p></description>
    </release>
    <release version="0.4.0" date="2026-07-24">
      <description><p>Project sidebar with git worktrees, diff indicators, archiving, sessions and a welcome screen.</p></description>
    </release>
    <release version="0.3.6" date="2026-05-10">
      <description><p>Forward Home and End to TUI apps when scrollback isn't engaged.</p></description>
    </release>
    <release version="0.3.3" date="2026-05-10">
      <description><p>Home and End keys scroll to top and bottom of scrollback.</p></description>
    </release>
    <release version="0.3.2" date="2026-05-09">
      <description><p>Clickable URLs in the terminal and context menu support.</p></description>
    </release>
    <release version="0.3.1" date="2026-04-06">
      <description><p>Nix flake cleanup.</p></description>
    </release>
    <release version="0.1.15" date="2026-04-06">
      <description><p>Nix support.</p></description>
    </release>
    <release version="0.1.14" date="2026-04-02">
      <description><p>Fix PTY processes not being cleaned up when closing tabs or panels.</p></description>
    </release>
    <release version="0.1.12" date="2026-04-01">
      <description><p>Release 0.1.12.</p></description>
    </release>
    <release version="0.1.11" date="2026-03-26">
      <description><p>Update Freya to 0.4.0-rc.16.</p></description>
    </release>
    <release version="0.1.5" date="2026-03-09">
      <description><p>Current release.</p></description>
    </release>
  </releases>
